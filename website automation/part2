package full_website;

import java.io.File;
import java.io.IOException;
import java.time.Duration;
import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.TakesScreenshot;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import org.testng.Assert;

public class part2 {
	


	    static WebDriver driver;

	    static WebDriverWait wait;

	    // =====================================================
	    // MAIN METHOD
	    // =====================================================

	    public static void main(String[] args)
	            throws IOException {

	        launchBrowser();

	        login();

	        verifyProductsPage();

	        addProductToCart("Sauce Labs Backpack");
	        verifyCartCount("1");

	        addProductToCart("Sauce Labs Bike Light");
	        verifyCartCount("2");

	        addProductToCart("Sauce Labs Bolt T-Shirt");
	        verifyCartCount("3");

	        openCart();

	        verifyCartItem("Sauce Labs Backpack");
	        verifyCartItem("Sauce Labs Bike Light");
	        verifyCartItem("Sauce Labs Bolt T-Shirt");

	        proceedToCheckout();

	        fillCheckoutInformation();

	        verifyOrderSummary();

	        completeOrder();

	        verifyOrderConfirmation();

//	        takeScreenshot();

	        closeBrowser();
	    }

	    // =====================================================
	    // LAUNCH BROWSER
	    // =====================================================

	    public static void launchBrowser() {

	        driver = new ChromeDriver();

	        driver.manage().window().maximize();

	        wait = new WebDriverWait(driver,
	                Duration.ofSeconds(10));

	        driver.get("https://www.saucedemo.com/");
	    }

	    // =====================================================
	    // LOGIN
	    // =====================================================

	    public static void login() {

	        driver.findElement(By.id("user-name"))
	                .sendKeys("standard_user");

	        driver.findElement(By.id("password"))
	                .sendKeys("secret_sauce");

	        driver.findElement(By.id("login-button"))
	                .click();

	        System.out.println("Login Successful");
	    }

	    // =====================================================
	    // VERIFY PRODUCTS PAGE
	    // =====================================================

	    public static void verifyProductsPage() {

	        String actualTitle = wait.until(
	                ExpectedConditions.visibilityOfElementLocated(
	                        By.className("title")))
	                .getText();

	        Assert.assertEquals(actualTitle,
	                "Products");

	        System.out.println("Products Page Verified");
	    }

	    // =====================================================
	    // ADD PRODUCT TO CART
	    // =====================================================

	    public static void addProductToCart(String productName) {

	        String xpath =
	                "//div[text()='" + productName + "']" +
	                "/ancestor::div[@class='inventory_item']" +
	                "//button";

	        WebElement addButton = wait.until(
	                ExpectedConditions.elementToBeClickable(
	                        By.xpath(xpath)));

	        addButton.click();

	        wait.until(ExpectedConditions.textToBePresentInElement(
	                addButton,
	                "Remove"));

	        System.out.println(productName
	                + " Added To Cart");
	    }

	    // =====================================================
	    // VERIFY CART COUNT
	    // =====================================================

	    public static void verifyCartCount(String expectedCount) {

	        String actualCount = wait.until(
	                ExpectedConditions.visibilityOfElementLocated(
	                        By.className("shopping_cart_badge")))
	                .getText();

	        System.out.println("Cart Count : "
	                + actualCount);

	        Assert.assertEquals(actualCount,
	                expectedCount);
	    }

	    // =====================================================
	    // OPEN CART
	    // =====================================================

	    public static void openCart() {

	        driver.findElement(
	                By.className("shopping_cart_link"))
	                .click();

	        System.out.println("Cart Opened");
	    }

	    // =====================================================
	    // VERIFY CART ITEMS
	    // =====================================================

	    public static void verifyCartItem(String expectedProduct) {

	        List<WebElement> cartItems =
	                driver.findElements(
	                        By.className("inventory_item_name"));

	        boolean productFound = false;

	        for (WebElement item : cartItems) {

	            if (item.getText()
	                    .equals(expectedProduct)) {

	                productFound = true;

	                break;
	            }
	        }

	        Assert.assertTrue(productFound);

	        System.out.println(expectedProduct
	                + " Verified");
	    }

	    // =====================================================
	    // PROCEED TO CHECKOUT
	    // =====================================================

	    public static void proceedToCheckout() {

	        WebElement checkoutButton = wait.until(
	                ExpectedConditions.elementToBeClickable(
	                        By.id("checkout")));

	        checkoutButton.click();

	        String checkoutTitle = driver.findElement(
	                By.className("title")).getText();

	        Assert.assertEquals(checkoutTitle,
	                "Checkout: Your Information");

	        System.out.println("Checkout Page Opened");
	    }

	    // =====================================================
	    // FILL SHIPPING INFORMATION
	    // =====================================================

	    public static void fillCheckoutInformation() {

	        driver.findElement(By.id("first-name"))
	                .sendKeys("Nikki");

	        driver.findElement(By.id("last-name"))
	                .sendKeys("R");

	        driver.findElement(By.id("postal-code"))
	                .sendKeys("500001");

	        driver.findElement(By.id("continue"))
	                .click();

	        System.out.println("Shipping Information Entered");
	    }

	    // =====================================================
	    // VERIFY ORDER SUMMARY
	    // =====================================================

	    public static void verifyOrderSummary() {

	        String summaryTitle = wait.until(
	                ExpectedConditions.visibilityOfElementLocated(
	                        By.className("title")))
	                .getText();

	        Assert.assertEquals(summaryTitle,
	                "Checkout: Overview");

	        // Verify payment info

	        WebElement paymentInfo = driver.findElement(
	                By.xpath("//div[contains(text(),'Payment Information')]"));

	        Assert.assertTrue(paymentInfo.isDisplayed());

	        // Verify total label

	        WebElement totalLabel = driver.findElement(
	                By.className("summary_total_label"));

	        Assert.assertTrue(totalLabel.isDisplayed());

	        System.out.println("Order Summary Verified");

	        System.out.println("Total : "
	                + totalLabel.getText());
	    }

	    // =====================================================
	    // COMPLETE ORDER
	    // =====================================================

	    public static void completeOrder() {

	        WebElement finishButton = wait.until(
	                ExpectedConditions.elementToBeClickable(
	                        By.id("finish")));

	        finishButton.click();

	        System.out.println("Order Completed");
	    }

	    // =====================================================
	    // VERIFY ORDER CONFIRMATION
	    // =====================================================

	    public static void verifyOrderConfirmation() {

	        WebElement confirmationMessage =
	                wait.until(
	                        ExpectedConditions.visibilityOfElementLocated(
	                                By.className("complete-header")));

	        String actualMessage =
	                confirmationMessage.getText();

	        System.out.println("Confirmation : "
	                + actualMessage);

	        Assert.assertEquals(actualMessage,
	                "Thank you for your order!");

	        Assert.assertTrue(
	                confirmationMessage.isDisplayed());

	        Assert.assertNotNull(
	                confirmationMessage);

	        System.out.println("Order Confirmation Verified");
	    }

