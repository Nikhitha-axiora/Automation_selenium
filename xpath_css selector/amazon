		                .getAttribute("href"));

		       
		        System.out.println(driver.findElement(
		                By.xpath("//div[contains(@class,'nav')]"))
		                .getAttribute("class"));

		       
		        System.out.println(driver.findElement(
		                By.xpath("//form[contains(@id,'search')]"))
		                .getAttribute("id"));

		        
		        System.out.println(driver.findElement(
		                By.xpath("//select[contains(@id,'search')]"))
