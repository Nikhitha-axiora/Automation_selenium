		        System.out.println(driver.findElement(
		                By.xpath("//span[starts-with(@id,'nav')]"))
		                .getAttribute("id"));

		      
		        System.out.println(driver.findElement(
		                By.xpath("//form[starts-with(@id,'nav')]"))
		                .getAttribute("id"));

