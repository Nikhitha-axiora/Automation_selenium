		        System.out.println(driver.findElement(
		                By.xpath("//div[@id='nav-belt']/child::div"))
		                .getAttribute("class"));

		       System.out.println(driver.findElement(
		                By.xpath("//form[@id='nav-search-bar-form']/child::div"))
